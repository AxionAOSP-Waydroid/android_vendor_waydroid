cc_binary {
    name: "waydroid-init",
    vendor: true,
    srcs: ["*.c"],
    header_libs: ["libva_headers"],
    shared_libs: ["libbase", "libcutils", "liblog"],
    arch: {
        x86: {
            header_libs: ["libva_headers"],
            shared_libs: ["libbase", "libcutils", "liblog", "libva", "libva-android"],
            cflags: ["-DUSE_VAAPI"],
        },
        x86_64: {
            header_libs: ["libva_headers"],
            shared_libs: ["libbase", "libcutils", "liblog", "libva", "libva-android"],
            cflags: ["-DUSE_VAAPI"],
        },
    }
}
