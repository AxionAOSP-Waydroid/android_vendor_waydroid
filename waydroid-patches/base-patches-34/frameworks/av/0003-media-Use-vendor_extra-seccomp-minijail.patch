From 694a9a9a799ef703585bfeac35a1c6e0d03f264d Mon Sep 17 00:00:00 2001
From: SupeChicken666 <me@supechicken666.dev>
Date: Fri, 18 Jul 2025 11:28:08 +0000
Subject: [PATCH 03/17] media: Use vendor_extra seccomp minijail

Change-Id: Ieb3b0bc91fdfbfb98e1f88c0221f143c1b1e6149
Signed-off-by: SupeChicken666 <me@supechicken666.dev>
---
 services/mediacodec/main_swcodecservice.cpp       | 4 +++-
 services/mediaextractor/main_extractorservice.cpp | 4 +++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/services/mediacodec/main_swcodecservice.cpp b/services/mediacodec/main_swcodecservice.cpp
index 9aa5d3df73..e05473810a 100644
--- a/services/mediacodec/main_swcodecservice.cpp
+++ b/services/mediacodec/main_swcodecservice.cpp
@@ -30,6 +30,8 @@ static const char kSystemSeccompPolicyPath[] =
         "/apex/com.android.media.swcodec/etc/seccomp_policy/mediaswcodec.policy";
 static const char kVendorSeccompPolicyPath[] =
         "/vendor/etc/seccomp_policy/mediaswcodec.policy";
+static const char kVendorExtraSeccompPolicyPath[] =
+        "/vendor_extra/etc/seccomp_policy/mediaswcodec.policy";
 
 extern "C" void RegisterCodecServices();
 
@@ -37,7 +39,7 @@ int main(int argc __unused, char** argv)
 {
     LOG(INFO) << "media swcodec service starting";
     signal(SIGPIPE, SIG_IGN);
-    SetUpMinijail(kSystemSeccompPolicyPath, kVendorSeccompPolicyPath);
+    SetUpMinijailList(kSystemSeccompPolicyPath, {kVendorSeccompPolicyPath, kVendorExtraSeccompPolicyPath});
     strcpy(argv[0], "media.swcodec");
 
     RegisterCodecServices();
diff --git a/services/mediaextractor/main_extractorservice.cpp b/services/mediaextractor/main_extractorservice.cpp
index 10b81356d1..7cca2afadf 100644
--- a/services/mediaextractor/main_extractorservice.cpp
+++ b/services/mediaextractor/main_extractorservice.cpp
@@ -42,6 +42,8 @@ static const char kSystemSeccompPolicyPath[] =
         "/apex/com.android.media/etc/seccomp_policy/mediaextractor.policy";
 static const char kVendorSeccompPolicyPath[] =
         "/vendor/etc/seccomp_policy/mediaextractor.policy";
+static const char kVendorExtraSeccompPolicyPath[] =
+        "/vendor_extra/etc/seccomp_policy/mediaextractor.policy";
 
 int main(int argc __unused, char** argv)
 {
@@ -64,7 +66,7 @@ int main(int argc __unused, char** argv)
     //calling the function before entering minijail, we can force dlopen.
     android::report_sysprop_change();
 
-    SetUpMinijail(kSystemSeccompPolicyPath, kVendorSeccompPolicyPath);
+    SetUpMinijailList(kSystemSeccompPolicyPath, {kVendorSeccompPolicyPath, kVendorExtraSeccompPolicyPath});
 
     strcpy(argv[0], "media.extractor");
     sp<ProcessState> proc(ProcessState::self());
-- 
2.50.1

