From e5acec34789c4c459d39b64bc6ccdd014b4e7a0d Mon Sep 17 00:00:00 2001
From: SupeChicken666 <me@supechicken666.dev>
Date: Fri, 18 Jul 2025 13:59:48 +0000
Subject: [PATCH 5/5] gralloc: Support more pixel formats

Change-Id: I5ec74e78cd702d8f2e7a7a8de843e6055491c4a0
Signed-off-by: SupeChicken666 <me@supechicken666.dev>
---
 modules/gralloc/gralloc.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/modules/gralloc/gralloc.cpp b/modules/gralloc/gralloc.cpp
index 69c6cd93..a5f103df 100644
--- a/modules/gralloc/gralloc.cpp
+++ b/modules/gralloc/gralloc.cpp
@@ -33,6 +33,8 @@
 #include <hardware/gralloc.h>
 #include <hardware/hardware.h>
 
+#define HAL_PIXEL_FORMAT_R8 0x38
+
 #include "gralloc_priv.h"
 #include "gr.h"
 
@@ -215,6 +217,7 @@ static int gralloc_alloc(alloc_device_t* dev,
         case HAL_PIXEL_FORMAT_RGBA_8888:
         case HAL_PIXEL_FORMAT_RGBX_8888:
         case HAL_PIXEL_FORMAT_BGRA_8888:
+        case HAL_PIXEL_FORMAT_RGBA_1010102:
             bytesPerPixel = 4;
             break;
         case HAL_PIXEL_FORMAT_RGB_888:
@@ -227,6 +230,9 @@ static int gralloc_alloc(alloc_device_t* dev,
         case HAL_PIXEL_FORMAT_BLOB:
             bytesPerPixel = 1;
             break;
+        case HAL_PIXEL_FORMAT_R8:
+            bytesPerPixel = 1;
+            break;
         default:
             ALOGE("gralloc_alloc bad format %d", format);
             return -EINVAL;
-- 
