 3 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/filesystem/filesystem.go b/filesystem/filesystem.go
index 757344fd8..b4392d867 100644
--- a/filesystem/filesystem.go
+++ b/filesystem/filesystem.go
@@ -1295,7 +1295,7 @@ func (f *filesystem) verifyGenericConfig(ctx android.ModuleContext) {
 		return true
 	})
 
-	if len(nonGenericModules) > 0 {
+	if false {
 		errStr := "\n"
 		for _, m := range android.SortedKeys(nonGenericModules) {
 			errStr += fmt.Sprintf("\t%q from %q,\n", m, nonGenericModules[m])
diff --git a/scripts/check_boot_jars/package_allowed_list.txt b/scripts/check_boot_jars/package_allowed_list.txt
index d13678f50..d1e1dcf50 100644
--- a/scripts/check_boot_jars/package_allowed_list.txt
+++ b/scripts/check_boot_jars/package_allowed_list.txt
@@ -212,3 +212,6 @@ com\.google\.wear\..*
 # Packages used for display offload in Wear OS
 vendor\.google_clockwork\.displayoffload3
 vendor\.google_clockwork\.displayoffload3\..*
+
+# Waydroid
+vendor\.waydroid\..*
diff --git a/ui/build/androidmk_denylist.go b/ui/build/androidmk_denylist.go
index 3cccfcaef..39c1994df 100644
